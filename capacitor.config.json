{
  "appId": "net.digikavach.kisan",
  "appName": "KisanKavach",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://kisan.digikavach.net",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "backgroundColor": "#ffffff",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
